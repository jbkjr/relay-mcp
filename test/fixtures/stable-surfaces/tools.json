  "escalate": {
    "type": "object",
    "properties": {
      "capabilities": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "localhost"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "connect",
                    "listen"
                  ]
                },
                "host": {
                  "default": "127.0.0.1",
                  "type": "string",
                  "enum": [
                    "127.0.0.1",
                    "::1"
                  ]
                },
                "api_effects": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                }
              },
              "required": [
                "kind",
                "port",
                "operation",
                "api_effects"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "port0"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "write_root"
                },
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "change_to_write": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "kind",
                "root"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "network"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "mediated",
                    "raw",
                    "local"
                  ]
                }
              },
              "required": [
                "kind",
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      },
      "continuation": {
        "type": "object",
        "properties": {
          "argv": {
            "minItems": 1,
            "maxItems": 4096,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "work": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "capabilities",
      "reason",
      "continuation"
    ],
    "additionalProperties": false
  },
