    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "open",
          "join",
          "send",
          "wait",
          "transcript",
          "close"
        ]
      },
      "purpose": {
        "type": "string",
        "maxLength": 1000
      },
      "invite": {
        "type": "string",
        "maxLength": 256
      },
      "cursor": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "text": {
        "type": "string"
      },
